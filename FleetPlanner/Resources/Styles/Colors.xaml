<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
    Colors.xaml — Defines all colour constants for the app's "Deep Space" theme.

    COLOUR SYSTEM:
    This uses Material Design 3's colour role naming convention:
    - Primary (#00d4ff cyan) — the main brand colour, used for buttons, links, tab highlights
    - OnPrimary (#0d0f14 near-black) — text/icon colour on Primary backgrounds
    - PrimaryContainer (#1c2030 dark blue) — subtle primary-tinted backgrounds (KPI cards)
    - Secondary (#f5a623 amber) — accent colour for badges, secondary actions
    - Tertiary (#22c55e green) — success/positive indicators, price highlights
    - Error (#ef4444 red) — destructive actions (delete), error states
    - Warning (#f59e0b amber) — offline banners, caution states
    - Background (#0d0f14) and Surface (#151820) — dark backgrounds for the space theme
    - On* colours — always the text/icon colour for the corresponding surface colour

    LIGHT vs DARK VARIANTS:
    Each colour has a "Light" and "Dark" variant (e.g., Primary and PrimaryDark). In this
    theme, both light and dark variants are identical because the app uses a unified dark
    "deep space" aesthetic. However, having both keys allows future light-theme support
    without changing any XAML bindings — just update the colour values here.

    ROLE COLOURS:
    RoleCombat, RoleCargo, etc. are semantic colours for ship role badges/indicators.
    These give visual distinction to different gameplay loops in the UI.

    BRUSH RESOURCES:
    SolidColorBrush resources (PrimaryBrush, etc.) wrap Color resources. Brushes are needed
    by certain MAUI properties (like Border.Stroke) that accept Brush, not Color.

    See: https://learn.microsoft.com/en-us/dotnet/maui/user-interface/theming
    See: https://m3.material.io/styles/color/system/overview
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ── Primary brand colour (Cyan #00d4ff) ─────────────────────── -->
    <Color x:Key="Primary">#00d4ff</Color>
    <Color x:Key="PrimaryDark">#00d4ff</Color>

    <Color x:Key="OnPrimary">#0d0f14</Color>
    <Color x:Key="OnPrimaryDark">#0d0f14</Color>

    <Color x:Key="PrimaryContainer">#1c2030</Color>
    <Color x:Key="PrimaryContainerDark">#1c2030</Color>

    <Color x:Key="OnPrimaryContainer">#e8eaf0</Color>
    <Color x:Key="OnPrimaryContainerDark">#e8eaf0</Color>

    <Color x:Key="Secondary">#f5a623</Color>
    <Color x:Key="SecondaryDark">#f5a623</Color>

    <Color x:Key="OnSecondary">#0d0f14</Color>
    <Color x:Key="OnSecondaryDark">#0d0f14</Color>

    <Color x:Key="SecondaryContainer">#2a2010</Color>
    <Color x:Key="SecondaryContainerDark">#2a2010</Color>

    <Color x:Key="OnSecondaryContainer">#f5a623</Color>
    <Color x:Key="OnSecondaryContainerDark">#f5a623</Color>

    <Color x:Key="Tertiary">#22c55e</Color>
    <Color x:Key="TertiaryDark">#22c55e</Color>

    <Color x:Key="OnTertiary">#0d0f14</Color>
    <Color x:Key="OnTertiaryDark">#0d0f14</Color>

    <Color x:Key="TertiaryContainer">#0f2418</Color>
    <Color x:Key="TertiaryContainerDark">#0f2418</Color>

    <Color x:Key="OnTertiaryContainer">#22c55e</Color>
    <Color x:Key="OnTertiaryContainerDark">#22c55e</Color>

    <Color x:Key="Error">#ef4444</Color>
    <Color x:Key="ErrorDark">#ef4444</Color>

    <Color x:Key="OnError">#ffffff</Color>
    <Color x:Key="OnErrorDark">#ffffff</Color>

    <Color x:Key="ErrorContainer">#2a0f0f</Color>
    <Color x:Key="ErrorContainerDark">#2a0f0f</Color>

    <Color x:Key="OnErrorContainer">#ef4444</Color>
    <Color x:Key="OnErrorContainerDark">#ef4444</Color>

    <!-- Background uses #0d0f14 (deep space blue-black) instead of the generic #121212 dark theme standard.
         This was an intentional design choice to reinforce the space aesthetic. -->
    <Color x:Key="Background">#0d0f14</Color>
    <Color x:Key="BackgroundDark">#0d0f14</Color>

    <Color x:Key="OnBackground">#e8eaf0</Color>
    <Color x:Key="OnBackgroundDark">#e8eaf0</Color>

    <Color x:Key="Surface">#151820</Color>
    <Color x:Key="SurfaceDark">#151820</Color>

    <Color x:Key="OnSurface">#e8eaf0</Color>
    <Color x:Key="OnSurfaceDark">#e8eaf0</Color>

    <Color x:Key="SurfaceVariant">#1c2030</Color>
    <Color x:Key="OnSurfaceVariant">#8890a8</Color>

    <Color x:Key="SurfaceVariantDark">#1c2030</Color>
    <Color x:Key="OnSurfaceVariantDark">#8890a8</Color>

    <Color x:Key="Outline">#00d4ff</Color>
    <Color x:Key="OutlineDark">#00d4ff</Color>

    <Color x:Key="OutlineVariant">#2a3050</Color>
    <Color x:Key="OutlineVariantDark">#2a3050</Color>

    <Color x:Key="Shadow">#000000</Color>
    <Color x:Key="ShadowDark">#000000</Color>

    <Color x:Key="SurfaceTint">#00d4ff</Color>
    <Color x:Key="SurfaceTintDark">#00d4ff</Color>

    <Color x:Key="InverseSurface">#e8eaf0</Color>
    <Color x:Key="InverseSurfaceDark">#e8eaf0</Color>
    <Color x:Key="InverseOnSurface">#0d0f14</Color>
    <Color x:Key="InverseOnSurfaceDark">#0d0f14</Color>

    <Color x:Key="InversePrimary">#006880</Color>
    <Color x:Key="InversePrimaryDark">#006880</Color>

    <Color x:Key="Scrim">#000000</Color>
    <Color x:Key="ScrimDark">#000000</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <!-- Semantic colors -->
    <Color x:Key="Warning">#f59e0b</Color>
    <Color x:Key="WarningDark">#f59e0b</Color>

    <Color x:Key="OnWarning">#0d0f14</Color>
    <Color x:Key="OnWarningDark">#0d0f14</Color>

    <Color x:Key="WarningContainer">#2a2010</Color>
    <Color x:Key="WarningContainerDark">#2a2010</Color>

    <Color x:Key="OnWarningContainer">#f59e0b</Color>
    <Color x:Key="OnWarningContainerDark">#f59e0b</Color>

    <!-- Role colors -->
    <Color x:Key="RoleCombat">#ef4444</Color>
    <Color x:Key="RoleCargo">#f59e0b</Color>
    <Color x:Key="RoleMining">#a855f7</Color>
    <Color x:Key="RoleExploration">#3b82f6</Color>
    <Color x:Key="RoleMedical">#22c55e</Color>
    <Color x:Key="RoleIndustrial">#f97316</Color>
    <Color x:Key="RoleSupport">#06b6d4</Color>

    <!-- Gray scale -->
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#8890a8</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <Color x:Key="Yellow100Accent">#F7B548</Color>
    <Color x:Key="Yellow200Accent">#FFD590</Color>
    <Color x:Key="Yellow300Accent">#FFE5B9</Color>
    <Color x:Key="Cyan100Accent">#00d4ff</Color>
    <Color x:Key="Cyan200Accent">#7BDDEF</Color>
    <Color x:Key="Cyan300Accent">#C3F2F4</Color>
    <Color x:Key="Blue100Accent">#3E8EED</Color>
    <Color x:Key="Blue200Accent">#72ACF1</Color>
    <Color x:Key="Blue300Accent">#A7CBF6</Color>

</ResourceDictionary>
