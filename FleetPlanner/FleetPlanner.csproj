<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0;net9.0-android</TargetFrameworks>
		<OutputType Condition="'$(TargetFramework)' == 'net9.0-android'">Exe</OutputType>
		<RootNamespace>FleetPlanner</RootNamespace>
		<UseMaui Condition="'$(TargetFramework)' != 'net9.0'">true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationTitle>Fleet Planner</ApplicationTitle>
		<ApplicationId>com.companyname.fleetplanner</ApplicationId>
		<ApplicationIdGuid>fb83656c-b1ef-4d45-90a5-d4511d92481c</ApplicationIdGuid>
		<ApplicationDisplayVersion>2.0</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
		<DefaultLanguage>en</DefaultLanguage>
	</PropertyGroup>

	<!-- MAUI resources — only for mobile targets -->
	<ItemGroup Condition="'$(TargetFramework)' != 'net9.0'">
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Exclude MAUI-only source files from net9.0 build -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<Compile Remove="App.xaml.cs" />
		<Compile Remove="AppShell.xaml.cs" />
		<Compile Remove="MauiProgram.cs" />
		<Compile Remove="Platforms\**\*.cs" />
		<Compile Remove="Views\**\*.cs" />
		<Compile Remove="Helpers\InvertedBoolConverter.cs" />
		<Compile Remove="ViewModels\DashboardViewModel.cs" />
		<Compile Remove="ViewModels\SettingsViewModel.cs" />
		<Compile Remove="ViewModels\ShipDetailViewModel.cs" />
		<Compile Remove="ViewModels\FleetDetailViewModel.cs" />
		<Compile Remove="ViewModels\FleetListViewModel.cs" />
		<Compile Remove="ViewModels\FleetManagementViewModel.cs" />
		<Compile Remove="Helpers\IsNotNullConverter.cs" />
	</ItemGroup>

	<!-- MAUI-specific packages — only for mobile targets -->
	<ItemGroup Condition="'$(TargetFramework)' != 'net9.0'">
		<PackageReference Include="LiveChartsCore.SkiaSharpView.Maui" Version="2.0.0-rc6.1" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
	</ItemGroup>

	<!-- Common packages for all targets -->
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.10" />
	</ItemGroup>

</Project>
