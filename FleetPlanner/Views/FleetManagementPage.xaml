<?xml version="1.0" encoding="utf-8" ?>
<!--
    FleetManagementPage.xaml — Create/edit form for fleet configuration.

    LAYOUT STRUCTURE:
    - ScrollView wrapping a VerticalStackLayout (the form)
    - Fleet Name (Entry), Description (Editor)
    - Primary Focus (Picker bound to FleetFocus enum names)
    - Operating Scale (Picker bound to FleetOperatingScale enum names)
    - Available Crew (Stepper + Label showing current value)
    - Declared Roles (CollectionView of CheckBoxes)
    - Action buttons: Save, Delete (hidden for new fleets), Cancel

    KEY XAML PATTERNS:
    - Picker SelectedIndex binding: MAUI Pickers don't natively bind to enums. Instead,
      we bind ItemsSource to an ObservableCollection<string> of enum names, and SelectedIndex
      to an int that maps to the enum's underlying value.
    - Stepper: a numeric up/down control. Minimum=1, Maximum=100, Increment=1. The Label
      beside it shows the current value via {Binding AvailableCrewCount}.
    - CheckBox inside CollectionView: each FleetRoleSelection item has IsSelected bound
      to the CheckBox. Because FleetRoleSelection extends ObservableObject, toggling the
      checkbox immediately updates the model.
    - IsVisible="{Binding IsNewFleet, Converter={StaticResource InvertedBoolConverter}}":
      hides the Delete button when creating a new fleet (can't delete what doesn't exist yet).

    See: https://learn.microsoft.com/en-us/dotnet/maui/user-interface/controls/picker
    See: https://learn.microsoft.com/en-us/dotnet/maui/user-interface/controls/stepper
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FleetPlanner.ViewModels"
             x:Class="FleetPlanner.Views.FleetManagementPage"
             x:DataType="vm:FleetManagementViewModel"
             Title="{Binding FleetName, StringFormat='Fleet: {0}'}">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="12">

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center" />

            <!-- Fleet Name -->
            <Label Text="Fleet Name" FontAttributes="Bold" />
            <Entry Text="{Binding FleetName}" Placeholder="Enter fleet name" />

            <!-- Description -->
            <Label Text="Description" FontAttributes="Bold" />
            <Editor Text="{Binding Description}" Placeholder="Optional description" HeightRequest="60" />

            <!-- Primary Focus -->
            <Label Text="Primary Focus" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding FocusOptions}"
                    SelectedIndex="{Binding SelectedFocusIndex}" />

            <!-- Operating Scale -->
            <Label Text="Operating Scale" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding ScaleOptions}"
                    SelectedIndex="{Binding SelectedScaleIndex}" />

            <!-- Available Crew -->
            <Label Text="Available Crew Count" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="8">
                <Stepper Minimum="1" Maximum="100" Increment="1"
                         Value="{Binding AvailableCrewCount}" />
                <Label Text="{Binding AvailableCrewCount}" VerticalOptions="Center" FontSize="16" FontAttributes="Bold" />
            </HorizontalStackLayout>

            <!-- Declared Roles -->
            <Label Text="Declared Roles" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding RoleSelections}" HeightRequest="300">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FleetRoleSelection">
                        <HorizontalStackLayout Spacing="8" Padding="4">
                            <CheckBox IsChecked="{Binding IsSelected}" />
                            <Label Text="{Binding DisplayName}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Action Buttons -->
            <Button Text="Save Fleet" Command="{Binding SaveCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource OnPrimary}" />

            <Button Text="Delete Fleet" Command="{Binding DeleteCommand}"
                    BackgroundColor="{StaticResource Error}"
                    TextColor="{StaticResource OnError}"
                    IsVisible="{Binding IsNewFleet, Converter={StaticResource InvertedBoolConverter}}" />

            <Button Text="Cancel" Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Gray400}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
