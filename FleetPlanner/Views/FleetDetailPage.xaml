<?xml version="1.0" encoding="utf-8" ?>
<!--
    FleetDetailPage.xaml — Detail view for a single fleet and its ships.

    LAYOUT STRUCTURE:
    - Shell.TitleView: custom title bar showing the fleet name
    - Fleet Intent Summary frame (focus, crew, scale)
    - Inline edit frame (visible only when IsEditing=true)
    - Ships CollectionView with swipe-to-remove
    - Bottom button bar: Edit, Settings (→ FleetManagementPage), + Add Ship (→ ShipBrowserPage)

    KEY XAML PATTERNS:
    - Title="{Binding FleetName}" dynamically sets the navigation bar title from the ViewModel.
    - Shell.TitleView: overrides the default title Label with a custom HorizontalStackLayout,
      allowing rich title formatting (bold, custom colour, icons).
    - IsVisible="{Binding IsEditing}" toggles the edit form. Only one of the read-only or edit
      sections is visible at a time.
    - CollectionView.EmptyView: shown when the Ships collection has zero items.
    - SwipeView with RelativeSource AncestorType to bind the Remove command from the
      DataTemplate's context (FleetShipDisplay) back up to the ViewModel.

    See: https://learn.microsoft.com/en-us/dotnet/maui/fundamentals/shell/pages#set-page-title
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FleetPlanner.ViewModels"
             x:Class="FleetPlanner.Views.FleetDetailPage"
             x:DataType="vm:FleetDetailViewModel"
             Title="{Binding FleetName}">

    <Shell.TitleView>
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Label Text="{Binding FleetName}" Style="{StaticResource Title1}"
                   VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
        </HorizontalStackLayout>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">

                <!-- Fleet Intent Summary -->
                <Frame Padding="12" CornerRadius="8">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding FleetIntentSummary}" FontSize="14" FontAttributes="Bold" />
                        <Label Text="{Binding Description}" FontSize="12" TextColor="{StaticResource Gray400}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Fleet Info (Edit Mode) -->
                <Frame Padding="12" CornerRadius="8" IsVisible="{Binding IsEditing}">
                    <VerticalStackLayout Spacing="8">
                        <Entry Text="{Binding FleetName}" Placeholder="Fleet Name" />
                        <Editor Text="{Binding Description}" Placeholder="Description" HeightRequest="60" />
                        <Button Text="Save" Command="{Binding SaveFleetCommand}"
                                BackgroundColor="{StaticResource Tertiary}"
                                TextColor="{StaticResource OnTertiary}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Ships Section -->
                <Label Text="Ships" FontSize="20" FontAttributes="Bold" Margin="0,8,0,0" />

                <CollectionView ItemsSource="{Binding Ships}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FleetShipDisplay">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Remove"
                                                   BackgroundColor="{StaticResource Error}"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FleetDetailViewModel}}, Path=RemoveShipCommand}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Frame Padding="12" Margin="0,4" CornerRadius="8">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding ShipName}" FontSize="16" FontAttributes="Bold" />
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding PriceUsd, StringFormat='${0:N0}'}"
                                               FontSize="14" TextColor="{StaticResource Tertiary}" />
                                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="8">
                                            <Label Text="{Binding Role}" FontSize="12" TextColor="{StaticResource Gray400}" />
                                            <Frame Padding="4,2" CornerRadius="4" HasShadow="False"
                                                   BackgroundColor="{StaticResource Secondary}">
                                                <Label Text="{Binding AcquisitionBadge}" FontSize="9"
                                                       TextColor="{StaticResource OnSecondary}" />
                                            </Frame>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                            <Label Text="{Binding CrewDisplay, StringFormat='Crew: {0}'}" FontSize="11" TextColor="{StaticResource Gray400}" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Row="2" Grid.Column="0"
                                               Text="{Binding Manufacturer}" FontSize="12" TextColor="{StaticResource Gray400}" />
                                    </Grid>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="No ships in this fleet yet. Tap 'Add Ship' to browse." Margin="0,16"
                               HorizontalTextAlignment="Center" TextColor="{StaticResource Gray400}" />
                    </CollectionView.EmptyView>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom buttons -->
        <HorizontalStackLayout Grid.Row="2" Spacing="8" HorizontalOptions="Fill" Margin="0,8,0,0">
            <Button Text="Edit" Command="{Binding ToggleEditCommand}"
                    BackgroundColor="{StaticResource Secondary}"
                    TextColor="{StaticResource OnSecondary}"
                    HorizontalOptions="FillAndExpand" />
            <Button Text="Settings" Command="{Binding ManageFleetCommand}"
                    BackgroundColor="{StaticResource Tertiary}"
                    TextColor="{StaticResource OnTertiary}"
                    HorizontalOptions="FillAndExpand" />
            <Button Text="+ Add Ship" Command="{Binding AddShipCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource OnPrimary}"
                    HorizontalOptions="FillAndExpand" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
