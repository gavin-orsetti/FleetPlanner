<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FleetPlanner.ViewModels"
             x:Class="FleetPlanner.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">

            <!-- Theme -->
            <Frame Padding="16" CornerRadius="8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Appearance" FontSize="18" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="Dark Mode" VerticalOptions="Center" />
                        <Switch IsToggled="{Binding IsDarkMode}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Cache Management -->
            <Frame Padding="16" CornerRadius="8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Ship Data Cache" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding LastUpdated, StringFormat='Last updated: {0}'}"
                           TextColor="{StaticResource Gray400}" />
                    <Button Text="Refresh Ship Data"
                            Command="{Binding RefreshCacheCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource OnPrimary}"
                            CornerRadius="8" />
                    <ActivityIndicator IsRunning="{Binding IsRefreshing}" IsVisible="{Binding IsRefreshing}"
                                       HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- About -->
            <Frame Padding="16" CornerRadius="8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="About" FontSize="18" FontAttributes="Bold" />
                    <Label Text="Fleet Planner V2" FontSize="14" />
                    <Label Text="A Star Citizen fleet management app." FontSize="12" TextColor="{StaticResource Gray400}" />
                    <Image Source="made_by_the_community_white.png"
                           MaximumWidthRequest="150" MaximumHeightRequest="150" />
                    <Label Text="This is an unofficial Star Citizen fan project, not affiliated with the Cloud Imperium group of companies."
                           FontSize="10" TextColor="{StaticResource Gray400}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
