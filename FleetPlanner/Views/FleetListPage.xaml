<?xml version="1.0" encoding="utf-8" ?>
<!--
    FleetListPage.xaml — Master list of all user-created fleets.

    LAYOUT STRUCTURE:
    - Grid with 3 rows: loading indicator, fleet list (or empty state), add button
    - RefreshView wraps CollectionView for pull-to-refresh on mobile
    - SwipeView on each item for swipe-to-delete

    KEY XAML PATTERNS:
    - RefreshView: binds Command to LoadFleetsCommand and IsRefreshing to IsLoading for
      pull-to-refresh behaviour. See: https://learn.microsoft.com/en-us/dotnet/maui/user-interface/controls/refreshview
    - SwipeView: wraps each fleet card, providing a "Delete" swipe action on the right side.
    - RelativeSource AncestorType: Inside the DataTemplate, the binding context is a Fleet item.
      To reach the ViewModel's commands, we use {Binding Source={RelativeSource AncestorType={x:Type vm:FleetListViewModel}}, Path=DeleteFleetCommand}.
      This walks up the visual tree to find the ViewModel.
    - TapGestureRecognizer: adds tap-to-navigate to each fleet card (navigates to FleetDetailPage).
    - x:DataType inside DataTemplate: <DataTemplate x:DataType="models:Fleet"> enables compiled
      bindings within the template — the compiler checks that Fleet has Name, PrimaryFocusEnum, etc.

    See: https://learn.microsoft.com/en-us/dotnet/maui/fundamentals/data-binding/relative-bindings
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FleetPlanner.ViewModels"
             xmlns:models="clr-namespace:FleetPlanner.Models;assembly=FleetPlanner.Core"
             x:Class="FleetPlanner.Views.FleetListPage"
             x:DataType="vm:FleetListViewModel"
             Title="My Fleet">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <!-- Loading -->
        <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center" Color="{StaticResource Primary}" />

        <!-- Empty state -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsEmpty}"
                             VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
            <Label Text="No fleets yet" FontSize="20" HorizontalTextAlignment="Center" />
            <Label Text="Tap + to create your first fleet" FontSize="14"
                   HorizontalTextAlignment="Center" TextColor="{StaticResource Gray400}" />
        </VerticalStackLayout>

        <!-- Fleet list -->
        <RefreshView Grid.Row="1" Command="{Binding LoadFleetsCommand}" IsRefreshing="{Binding IsLoading}">
            <CollectionView ItemsSource="{Binding Fleets}" IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Fleet">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete"
                                               BackgroundColor="{StaticResource Error}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FleetListViewModel}}, Path=DeleteFleetCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Frame Padding="16" Margin="0,4" CornerRadius="8"
                                   BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FleetListViewModel}}, Path=GoToFleetDetailCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                                    <Label Text="{Binding PrimaryFocusEnum, StringFormat='Focus: {0}'}" FontSize="12"
                                           TextColor="{StaticResource Gray400}" />
                                    <HorizontalStackLayout Spacing="12">
                                        <Label Text="{Binding AvailableCrewCount, StringFormat='{0} crew'}" FontSize="12"
                                               TextColor="{StaticResource Gray400}" />
                                        <Label Text="{Binding OperatingScaleEnum, StringFormat='{0} scale'}" FontSize="12"
                                               TextColor="{StaticResource Gray400}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Add fleet button -->
        <Button Grid.Row="2" Text="+ New Fleet"
                Command="{Binding AddFleetCommand}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="{StaticResource OnPrimary}"
                Margin="0,8,0,0"
                CornerRadius="8" />
    </Grid>
</ContentPage>
