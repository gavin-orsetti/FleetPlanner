<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FleetPlanner.ViewModels"
             xmlns:models="clr-namespace:FleetPlanner.Models;assembly=FleetPlanner.Core"
             x:Class="FleetPlanner.Views.GroupDetailPage"
             x:DataType="vm:GroupDetailViewModel"
             Title="{Binding Group.Name}">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="12">

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center" />

            <!-- Group Info -->
            <Label Text="{Binding Group.Name}" FontSize="22" FontAttributes="Bold" />
            <Label Text="{Binding Group.Description}" FontSize="14" TextColor="{StaticResource Gray400}" />
            <Label Text="{Binding Group.IntendedFocus, StringFormat='Focus: {0}'}"
                   FontSize="12" TextColor="{StaticResource Gray500}" />
            <Label Text="{Binding Group.CrewTarget, StringFormat='Crew target: {0}'}"
                   FontSize="12" TextColor="{StaticResource Gray500}" />

            <!-- Doctrine Tags -->
            <Label Text="Doctrine Tags" FontSize="14" FontAttributes="Bold" Margin="0,8,0,0" />
            <CollectionView ItemsSource="{Binding GroupTags}" HeightRequest="50">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:UserFleetGroupTag">
                        <Frame Padding="6,4" CornerRadius="4" HasShadow="False"
                               BackgroundColor="{StaticResource Secondary}">
                            <Label Text="{Binding TagKey}" FontSize="12"
                                   TextColor="{StaticResource OnSecondary}" />
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No doctrine tags assigned" FontSize="12" TextColor="{StaticResource Gray400}" />
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Member Ships -->
            <Label Text="Member Ships" FontSize="14" FontAttributes="Bold" Margin="0,8,0,0" />
            <CollectionView ItemsSource="{Binding MemberShips}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OwnedShipDisplay">
                        <Frame Padding="10" Margin="0,4" CornerRadius="8"
                               BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding ShipName}" FontSize="14" FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding AcquisitionBadge}" FontSize="10"
                                       TextColor="{StaticResource Tertiary}" />
                                <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="8">
                                    <Label Text="{Binding Callsign}" FontSize="11" TextColor="{StaticResource Gray400}" />
                                    <Label Text="{Binding Role}" FontSize="11" TextColor="{StaticResource Gray400}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No ships assigned to this group yet."
                           FontSize="12" TextColor="{StaticResource Gray400}" Margin="0,8" />
                </CollectionView.EmptyView>
            </CollectionView>

            <Button Text="Back" Command="{Binding GoBackCommand}" Margin="0,16,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
