<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FleetPlanner.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FleetPlanner.Views"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Dashboard"
                      ContentTemplate="{DataTemplate views:DashboardPage}"
                      Route="DashboardPage" />

        <ShellContent Title="My Fleet"
                      ContentTemplate="{DataTemplate views:FleetListPage}"
                      Route="FleetListPage" />

        <ShellContent Title="Ships"
                      ContentTemplate="{DataTemplate views:ShipBrowserPage}"
                      Route="ShipBrowserPage" />

        <ShellContent Title="Recommend"
                      ContentTemplate="{DataTemplate views:RecommendationsPage}"
                      Route="RecommendationsPage" />

        <ShellContent Title="Settings"
                      ContentTemplate="{DataTemplate views:SettingsPage}"
                      Route="SettingsPage" />
    </TabBar>

</Shell>
